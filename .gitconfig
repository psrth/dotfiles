[user]
	name = psrth
	email = git@psrth.sh
# github auth via gh (one token, managed by `gh auth login`). the empty helper
# clears homebrew git's default osxkeychain helper for these hosts.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
