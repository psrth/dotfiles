<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- installed by setup.sh, which replaces __HOME__ with the real home dir -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.psrth.agents-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.dotfiles/bin/agents-backup</string>
  </array>
  <!-- daily at 06:00; if the mac is asleep, runs on next wake -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/agents-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agents-backup.log</string>
</dict>
</plist>
